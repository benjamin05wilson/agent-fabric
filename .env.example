DATABASE_URL=postgresql+asyncpg://agent_fabric:agent_fabric@postgres:5432/agent_fabric
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=agent_fabric
MINIO_SECRET_KEY=agent_fabric_dev_only
MINIO_BUCKET=run-logs
MINIO_SECURE=false
API_KEY=af_dev_key
API_KEY_PROJECT=local
# Admission limits for the seeded project; raise both before running the benchmark tiers.
PROJECT_MAX_QUEUED=1000
PROJECT_MAX_RUNNING=20
# Uncomment to expose scheduler/gateway Prometheus metrics (the API always serves /metrics).
# METRICS_PORT=9101
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRPC_BIND=0.0.0.0:50051

